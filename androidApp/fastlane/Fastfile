require "fileutils"

default_platform(:android)

def play_json_key_path
  path = ENV["ANDROID_PLAY_CONFIG_JSON_PATH"].to_s
  UI.user_error!("ANDROID_PLAY_CONFIG_JSON_PATH must point to a readable Google Play service account json key") if path.empty? || !File.exist?(path)
  path
end

platform :android do
  desc "Upload a prebuilt Android App Bundle to Google Play internal testing"
  lane :deploy do
    aab_path = ENV["ANDROID_AAB_PATH"]
    UI.user_error!("ANDROID_AAB_PATH must point to a readable Android App Bundle") if aab_path.to_s.empty? || !File.exist?(aab_path)

    # completed = immediately available to internal testers (not draft)
    release_status = ENV.fetch("ANDROID_PLAY_RELEASE_STATUS", "completed")

    upload_to_play_store(
      json_key: play_json_key_path,
      track: ENV.fetch("ANDROID_PLAY_TRACK", "internal"),
      release_status: release_status,
      skip_upload_apk: true,
      skip_upload_metadata: true,
      skip_upload_changelogs: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
      aab: aab_path
    )
  end

  desc "Sync Play Store listing metadata, graphics, and screenshots (no AAB upload)"
  lane :sync_store_listing do
    # Requires Play Console SA permission to manage store presence / commit listing edits.
    # Without that, uploads may succeed into an edit but commit returns 403 PERMISSION_DENIED.

    # supply gives up on the first Google API error unless this is set. Image uploads
    # regularly fail with "Upload has already been terminated": the google-api-client
    # retries a resumable session that Google has already closed, which surfaces as a
    # non-retryable 400. Retrying at the supply level starts a fresh session from the
    # file path, so it recovers instead of aborting the whole listing sync.
    ENV["SUPPLY_UPLOAD_MAX_RETRIES"] = ENV.fetch("SUPPLY_UPLOAD_MAX_RETRIES", "5")

    upload_to_play_store(
      json_key: play_json_key_path,
      track: ENV.fetch("ANDROID_PLAY_TRACK", "internal"),
      skip_upload_apk: true,
      skip_upload_aab: true,
      skip_upload_changelogs: true,
      skip_upload_metadata: false,
      skip_upload_images: false,
      skip_upload_screenshots: false,
      # Compare sha256 against the live listing and only upload what actually changed.
      # Without this, supply deletes every screenshot before re-uploading, so a failure
      # part way through leaves the listing with no screenshots at all.
      sync_image_upload: true,
      metadata_path: "fastlane/metadata/android",
      changes_not_sent_for_review: true,
      # Socket timeout per attempt. These are ~250 KB PNGs that upload in a few
      # seconds, so a request still open after two minutes has stalled. Keeping
      # this low is what makes the retries useful - a long timeout just parks the
      # whole sync on one dead connection.
      timeout: 120
    )
  end

  desc "Promote the newest internal release to production (no binary upload)"
  lane :promote_to_production do
    json_key = play_json_key_path
    latest = google_play_track_version_codes(track: "internal", json_key: json_key).map(&:to_i).max
    UI.user_error!("No internal release found to promote") unless latest

    changelog = ENV["WHATS_NEW_PLAY_FILE"]
    if changelog && File.exist?(changelog)
      changelogs_dir = File.join("fastlane", "metadata", "android", "en-US", "changelogs")
      FileUtils.mkdir_p(changelogs_dir)
      FileUtils.cp(changelog, File.join(changelogs_dir, "#{latest}.txt"))
      UI.message("Staged 'what's new' for versionCode #{latest}")
    end

    upload_to_play_store(
      json_key: json_key,
      track: "internal",
      track_promote_to: "production",
      version_code: latest,
      skip_upload_apk: true,
      skip_upload_aab: true,
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
      skip_upload_changelogs: changelog ? false : true
    )
    UI.success("Promoted internal release #{latest} to production")
  end
end
