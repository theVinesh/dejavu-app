require "fileutils"

default_platform(:ios)

def ci?
  ENV["CI"].to_s == "true"
end

def env_present?(key)
  !ENV[key].to_s.strip.empty?
end

def ios_app_identifier
  ENV["IOS_APP_IDENTIFIER"].to_s.strip.empty? ? "com.thevinesh.dejavu" : ENV["IOS_APP_IDENTIFIER"].strip
end

def ios_team_id
  ENV["IOS_TEAM_ID"].to_s.strip.empty? ? "9S95C26JN6" : ENV["IOS_TEAM_ID"].strip
end

def missing_build_requirements
  %w[
    MATCH_GIT_URL
    MATCH_PASSWORD
    APP_STORE_CONNECT_API_KEY_KEY_ID
    APP_STORE_CONNECT_API_KEY_ISSUER_ID
    APP_STORE_CONNECT_API_KEY_KEY
  ].reject { |key| env_present?(key) }
end

def missing_upload_requirements
  %w[
    APP_STORE_CONNECT_API_KEY_KEY_ID
    APP_STORE_CONNECT_API_KEY_ISSUER_ID
    APP_STORE_CONNECT_API_KEY_KEY
  ].reject { |key| env_present?(key) }
end

def ios_build_number
  ENV["GITHUB_RUN_NUMBER"].to_s.strip.empty? ? "1" : ENV["GITHUB_RUN_NUMBER"].strip
end

def app_store_api_key
  app_store_connect_api_key(
    key_id: ENV["APP_STORE_CONNECT_API_KEY_KEY_ID"],
    issuer_id: ENV["APP_STORE_CONNECT_API_KEY_ISSUER_ID"],
    key_content: ENV["APP_STORE_CONNECT_API_KEY_KEY"],
    is_key_content_base64: true
  )
end

def match_options(api_key)
  options = {
    type: "appstore",
    readonly: ci?,
    app_identifier: [ios_app_identifier],
    team_id: ios_team_id,
    api_key: api_key
  }
  options[:git_url] = ENV["MATCH_GIT_URL"]
  options[:git_basic_authorization] = ENV["MATCH_GIT_BASIC_AUTHORIZATION"] if env_present?("MATCH_GIT_BASIC_AUTHORIZATION")
  options
end

platform :ios do
  desc "Build the TestFlight-ready iOS release artifact"
  lane :build_release_artifact do
    missing = missing_build_requirements
    if missing.any?
      UI.user_error!("Missing Apple-side prerequisites or GitHub secrets for iOS release build: #{missing.join(', ')}")
    end

    setup_ci if ci?

    api_key = app_store_api_key
    build_number = ios_build_number

    match(**match_options(api_key))
    UI.message("Building iOS release artifact with build number #{build_number}")

    build_app(
      project: "iosApp.xcodeproj",
      scheme: "iosApp",
      clean: true,
      export_method: "app-store",
      xcargs: "APP_BUILD_NUMBER=#{build_number}",
      output_directory: "build/ci-release",
      output_name: "DejaVu.ipa"
    )
  end

  desc "Upload a prebuilt iOS release artifact to TestFlight"
  lane :deploy do
    ipa_path = ENV["IOS_IPA_PATH"]
    UI.user_error!("IOS_IPA_PATH must point to a readable IPA") if ipa_path.to_s.empty? || !File.exist?(ipa_path)

    missing = missing_upload_requirements
    if missing.any?
      UI.user_error!("Missing App Store Connect API credentials for iOS upload: #{missing.join(', ')}")
    end

    api_key = app_store_api_key

    upload_to_testflight(
      api_key: api_key,
      ipa: ipa_path,
      skip_waiting_for_build_processing: false,
      distribute_external: false,
      notify_external_testers: false
    )
  end

  desc "Sync App Store listing metadata and screenshots (no binary upload)"
  lane :sync_store_listing do
    missing = missing_upload_requirements
    if missing.any?
      UI.user_error!("Missing App Store Connect API credentials for metadata sync: #{missing.join(', ')}")
    end

    api_key = app_store_api_key

    deliver(
      api_key: api_key,
      app_identifier: ios_app_identifier,
      metadata_path: "fastlane/metadata",
      screenshots_path: "fastlane/screenshots",
      skip_binary_upload: true,
      skip_app_version_update: true,
      force: true,
      run_precheck_before_submit: false,
      submit_for_review: false,
      overwrite_screenshots: true,
      precheck_include_in_app_purchases: false
    )

    prune_duplicate_screenshots
  end

  desc "Delete duplicate App Store screenshots left behind by an earlier sync"
  lane :prune_screenshots do
    missing = missing_upload_requirements
    if missing.any?
      UI.user_error!("Missing App Store Connect API credentials for screenshot cleanup: #{missing.join(', ')}")
    end

    app_store_api_key
    prune_duplicate_screenshots
  end

  desc "Submit the newest valid TestFlight build for App Store review"
  lane :submit_for_review do
    missing = missing_upload_requirements
    UI.user_error!("Missing App Store Connect API credentials: #{missing.join(', ')}") if missing.any?

    api_key = app_store_api_key
    app = Spaceship::ConnectAPI::App.find(ios_app_identifier)
    UI.user_error!("App not found: #{ios_app_identifier}") unless app

    builds = Spaceship::ConnectAPI::Build.all(
      app_id: app.id,
      sort: "-version",
      limit: 30
    )
    build = builds.find { |candidate| candidate.processing_state == "VALID" }
    states = builds.map(&:processing_state).uniq.join(", ")
    UI.user_error!("No VALID TestFlight build to submit (seen states: #{states})") unless build
    build_number = build.version.to_s
    version_string = build.app_version.to_s
    UI.message("Submitting build #{build_number} (version #{version_string}) for App Store review")

    platform = Spaceship::ConnectAPI::Platform::IOS
    edit_version = app.get_edit_app_store_version(platform: platform)
    if edit_version && edit_version.version_string != version_string
      UI.message("Retargeting editable App Store version #{edit_version.version_string} -> #{version_string}")
      app.ensure_version!(version_string, platform: platform)
    end

    edit = nil
    8.times do |index|
      edit = app.get_edit_app_store_version(platform: platform)
      break if edit
      sleep [10 * (2**index), 300].min
    end
    UI.user_error!("Timed out waiting for an editable App Store version") unless edit

    notes = ENV["WHATS_NEW_IOS_FILE"]
    if notes && File.exist?(notes)
      notes_path = File.join("fastlane", "metadata", "en-US", "release_notes.txt")
      FileUtils.mkdir_p(File.dirname(notes_path))
      FileUtils.cp(notes, notes_path)
      UI.message("Staged 'what's new' release notes")
    end

    deliver(
      api_key: api_key,
      app_identifier: ios_app_identifier,
      app_version: version_string,
      build_number: build_number,
      metadata_path: "fastlane/metadata",
      screenshots_path: "fastlane/screenshots",
      skip_binary_upload: true,
      skip_app_version_update: true,
      skip_screenshots: true,
      submit_for_review: true,
      reject_if_possible: true,
      run_precheck_before_submit: false,
      force: true,
      overwrite_screenshots: true,
      submission_information: {
        export_compliance_uses_encryption: false,
        export_compliance_encryption_updated: false
      }
    )
    prune_duplicate_screenshots
    UI.success("Submitted build #{build_number} for App Store review")
  end
end

# deliver verifies its uploads by re-reading the screenshot sets and matching
# source checksums. App Store Connect does not list a screenshot until it has
# finished processing it, so the check can run against a set that still looks
# empty, deliver concludes every screenshot is missing, and uploads the whole
# batch a second time - which is how the listing ends up with two copies of
# each screen. Nothing in deliver reconciles that afterwards, so drop the extra
# copies here: within each set, keep the first screenshot per source checksum.
#
# Relies on the Spaceship session that `app_store_api_key` establishes, so call
# that first.
def prune_duplicate_screenshots
  app = Spaceship::ConnectAPI::App.find(ios_app_identifier)
  UI.user_error!("Could not find app #{ios_app_identifier} on App Store Connect") if app.nil?

  version = app.get_edit_app_store_version(platform: Spaceship::ConnectAPI::Platform::IOS)
  if version.nil?
    UI.important("No editable App Store version - skipping screenshot cleanup")
    return
  end

  # The same lag that makes deliver double-upload would make this pass see a set
  # that is still filling up, so wait for the listing to settle first. Otherwise
  # a run right after an upload happily reports no duplicates.
  screenshot_sets = wait_for_settled_screenshot_sets(version)

  removed = 0
  summary = []

  screenshot_sets.each do |locale, display_type, screenshots|
    seen = {}
    kept = 0

    screenshots.each do |screenshot|
      checksum = screenshot.source_file_checksum

      # A screenshot with no checksum has not finished processing. Keep it rather
      # than guess, so a healthy upload is never deleted.
      if checksum.nil?
        UI.important("Leaving #{locale} #{display_type} screenshot #{screenshot.file_name} in place - still processing")
        kept += 1
      elsif seen.key?(checksum)
        UI.message("Removing duplicate #{locale} #{display_type} screenshot #{screenshot.file_name}")
        screenshot.delete!
        removed += 1
      else
        seen[checksum] = screenshot.id
        kept += 1
      end
    end

    summary << "#{locale} #{display_type}: #{kept}"
  end

  UI.message("Screenshots on App Store Connect - #{summary.join(', ')}")
  if removed.zero?
    UI.success("No duplicate screenshots found")
  else
    UI.success("Removed #{removed} duplicate screenshot(s)")
  end
end

# Re-read every screenshot set until the total count stops changing and nothing is
# mid-processing. Returns [locale, display_type, screenshots] triples.
def wait_for_settled_screenshot_sets(version, timeout: 300, interval: 10)
  deadline = Time.now + timeout
  previous_count = nil

  loop do
    sets = version.get_app_store_version_localizations.flat_map do |localization|
      localization.get_app_screenshot_sets.map do |screenshot_set|
        [localization.locale, screenshot_set.screenshot_display_type, screenshot_set.app_screenshots || []]
      end
    end

    all_screenshots = sets.flat_map { |_, _, screenshots| screenshots }
    processing = all_screenshots.count { |screenshot| screenshot.source_file_checksum.nil? }
    settled = processing.zero? && previous_count == all_screenshots.count

    return sets if settled || Time.now >= deadline

    UI.message("Waiting for App Store Connect to settle - #{all_screenshots.count} screenshot(s), #{processing} still processing")
    previous_count = all_screenshots.count
    sleep(interval)
  end
end
